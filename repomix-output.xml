              <div className="h-[4px] rounded-[2px] overflow-hidden" style={{ background: 'rgba(255,255,255,.12)' }}>
                <div className="h-full rounded-[2px] prog-fill" style={{ width: `${a.pct}%`, background: 'rgba(255,255,255,.55)' }} />
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

