<file path="page.html">
<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Scam Detector — PDPA Compliant</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --navy:        #0d1b2e;
  --navy-mid:    #152236;
  --navy-card:   #1a2b40;
  --navy-light:  #1e3050;
  --border:      rgba(255,255,255,0.07);
  --blue:        #2563eb;
  --blue-dim:    rgba(37,99,235,0.12);
  --teal:        #0891b2;
  --green:       #059669;
  --green-dim:   rgba(5,150,105,0.12);
  --red:         #dc2626;
  --red-dim:     rgba(220,38,38,0.12);
  --amber:       #d97706;
  --amber-dim:   rgba(217,119,6,0.12);
  --text-1:      #f1f5f9;
  --text-2:      #94a3b8;
  --text-3:      #64748b;
  --page-bg:     #eef2f7;
  --card-bg:     #ffffff;
  --font:        'DM Sans', 'IBM Plex Sans Thai', sans-serif;
  --mono:        'IBM Plex Mono', monospace;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: var(--font);
  background: var(--page-bg);
  color: var(--navy);
  font-size: 14px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* ── TOPBAR ─────────────────────────────── */
.topbar {
  background: var(--navy);
  height: 56px;
  padding: 0 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 90;
  border-bottom: 1px solid var(--border);
}
.tb-brand { display: flex; align-items: center; gap: 11px; }
.tb-logomark {
  width: 34px; height: 34px;
  border-radius: 8px;
  background: var(--blue);
  display: flex; align-items: center; justify-content: center;
}
.tb-logomark svg { width: 18px; height: 18px; fill: none; stroke: white; stroke-width: 2; }
.tb-name { font-size: 14px; font-weight: 700; color: var(--text-1); letter-spacing: 0.03em; }
.tb-sub  { font-size: 11px; color: var(--text-3); letter-spacing: 0.01em; }
.tb-right { display: flex; align-items: center; gap: 10px; }
.tb-pill {
  display: flex; align-items: center; gap: 7px;
  background: var(--navy-light);
  border: 1px solid var(--border);
  color: var(--text-2);
  padding: 5px 14px;
  border-radius: 99px;
  font-size: 12px;
  cursor: pointer;
  transition: border-color .2s;
}
.tb-pill:hover { border-color: rgba(255,255,255,0.18); }
.led {
  width: 6px; height: 6px; border-radius: 50%;
  flex-shrink: 0;
}
.led-green { background: #22c55e; box-shadow: 0 0 5px #22c55e; }
.led-blue  { background: #60a5fa; box-shadow: 0 0 5px #60a5fa; }
.led-red   { background: #f87171; box-shadow: 0 0 5px #f87171; }
.back-btn {
  display: flex; align-items: center; gap: 6px;
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text-2);
  padding: 5px 14px;
  border-radius: 7px;
  font-size: 12px; font-family: var(--font);
  cursor: pointer; transition: all .2s;
}
.back-btn:hover { background: var(--navy-light); color: var(--text-1); }

/* ── STATUSBAR ──────────────────────────── */
.statusbar {
  background: var(--navy-mid);
  padding: 6px 28px;
  display: flex; align-items: center; gap: 28px;
  border-bottom: 1px solid var(--border);
  flex-wrap: wrap;
}
.s-tag {
  font-size: 11px; color: var(--text-3);
  font-family: var(--mono);
  display: flex; align-items: center; gap: 5px;
}
.s-dot { width: 5px; height: 5px; border-radius: 50%; }
.s-dot-g { background: #22c55e; }
.s-dot-r { background: #f87171; }
.s-dot-y { background: #fbbf24; }
.s-dot-b { background: #60a5fa; }

/* ── PAGE SYSTEM ────────────────────────── */
.page { display: none; }
.page.active { display: block; animation: fadeIn .25s ease; }
@keyframes fadeIn { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:translateY(0); } }

/* ════════════════════════════════════════
   PAGE 1 — INPUT
════════════════════════════════════════ */
.p-input { background: var(--page-bg); min-height: calc(100vh - 90px); padding: 44px 24px; }

.input-shell {
  max-width: 820px; margin: 0 auto;
  background: var(--card-bg);
  border-radius: 16px;
  box-shadow: 0 2px 24px rgba(0,0,0,0.07), 0 1px 4px rgba(0,0,0,0.04);
  overflow: hidden;
}
.input-header {
  background: var(--navy);
  padding: 13px 22px;
  display: flex; align-items: center; justify-content: space-between;
}
.input-header-label {
  font-size: 11px; font-family: var(--mono); font-weight: 600;
  letter-spacing: 0.1em; color: var(--text-2);
  display: flex; align-items: center; gap: 10px;
}
.hdr-indicators { display: flex; gap: 5px; }
.hdr-ind {
  width: 9px; height: 9px; border-radius: 50%;
}
.hdr-ind-a { background: var(--blue); }
.hdr-ind-b { background: var(--teal); opacity: .5; }
.input-header-hint { font-size: 11px; color: var(--text-3); }

.input-body { padding: 24px 24px 22px; }

.type-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 10px; margin-bottom: 22px; }
.type-tile {
  border: 1.5px solid #e2e8f0;
  border-radius: 12px;
  padding: 16px 12px;
  cursor: pointer;
  background: #fafbfd;
  transition: border-color .2s, background .2s, box-shadow .2s;
}
.type-tile:hover { border-color: #93c5fd; background: #f0f7ff; }
.type-tile.sel {
  border-color: var(--blue);
  background: #eff6ff;
  box-shadow: 0 0 0 3px rgba(37,99,235,.08);
}
.tile-icon {
  width: 28px; height: 28px; margin-bottom: 9px;
  color: #94a3b8;
}
.type-tile.sel .tile-icon { color: var(--blue); }
.tile-icon svg { width: 100%; height: 100%; }
.tile-name { font-size: 12.5px; font-weight: 600; color: #1e293b; }
.type-tile.sel .tile-name { color: var(--blue); }
.tile-sub  { font-size: 11px; color: #94a3b8; margin-top: 2px; }

.field-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 9px; }
.field-row label { font-size: 12.5px; font-weight: 600; color: #334155; }
.char-ct { font-family: var(--mono); font-size: 11px; color: #94a3b8; }

textarea.main-ta {
  width: 100%; min-height: 130px;
  border: 1.5px solid #e2e8f0;
  border-radius: 11px;
  padding: 14px 16px;
  font-family: var(--font); font-size: 13.5px; color: #334155;
  resize: vertical; background: #fafbfd; outline: none;
  transition: border-color .2s, background .2s;
  line-height: 1.65;
}
textarea.main-ta:focus { border-color: #93c5fd; background: #fff; }
textarea.main-ta::placeholder { color: #b0bec5; }

.ta-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 12px; }
.sup-note { font-size: 11.5px; color: #64748b; display: flex; align-items: center; gap: 5px; }
.sup-note svg { width: 13px; height: 13px; }
.sample-row { display: flex; gap: 6px; }
.sample-btn {
  background: #f1f5f9; border: 1.5px solid #e2e8f0;
  color: #475569; border-radius: 7px; padding: 5px 13px;
  font-size: 11.5px; cursor: pointer; transition: all .2s;
  font-family: var(--font);
}
.sample-btn:hover { background: #e2e8f0; }

.analyze-btn {
  width: 100%; margin-top: 20px;
  background: var(--blue); color: #fff;
  border: none; border-radius: 11px;
  padding: 16px; font-size: 15px; font-weight: 700;
  cursor: pointer; font-family: var(--font);
  display: flex; align-items: center; justify-content: center; gap: 9px;
  transition: background .2s, transform .15s, box-shadow .2s;
  box-shadow: 0 3px 18px rgba(37,99,235,.3);
  letter-spacing: .01em;
}
.analyze-btn:hover { background: #1d4ed8; transform: translateY(-1px); box-shadow: 0 5px 24px rgba(37,99,235,.4); }
.analyze-btn:active { transform: translateY(0); }
.analyze-btn svg { width: 17px; height: 17px; }

/* ════════════════════════════════════════
   PAGE 2 — RESULT
════════════════════════════════════════ */
.p-result { background: var(--page-bg); min-height: calc(100vh - 90px); }

.hero-band {
  background: linear-gradient(135deg, #991b1b 0%, #7f1d1d 100%);
  padding: 28px 28px 32px;
  display: flex; gap: 28px; align-items: flex-start;
  position: relative; overflow: hidden;
}
.hero-band::after {
  content: '';
  position: absolute; inset: 0;
  background: repeating-linear-gradient(
    -45deg,
    rgba(255,255,255,.015) 0, rgba(255,255,255,.015) 1px,
    transparent 1px, transparent 14px
  );
  pointer-events: none;
}

.score-block { flex-shrink: 0; position: relative; z-index: 1; }
.score-label { font-size: 10px; font-family: var(--mono); letter-spacing: .1em; color: rgba(255,255,255,.45); text-transform: uppercase; text-align: center; margin-bottom: 7px; }
.score-box {
  width: 130px; height: 130px;
  background: rgba(0,0,0,.22);
  border: 1.5px solid rgba(255,255,255,.12);
  border-radius: 14px;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.score-num  { font-size: 50px; font-weight: 800; color: #fff; line-height: 1; font-family: var(--mono); }
.score-denom { font-size: 11px; color: rgba(255,255,255,.45); font-family: var(--mono); }
.score-pips { display: flex; gap: 3px; margin-top: 9px; }
.pip { width: 10px; height: 4px; border-radius: 2px; background: rgba(255,255,255,.18); }
.pip.on { background: rgba(255,255,255,.75); }
.pip.hi { background: #fff; }

.hero-content { flex: 1; position: relative; z-index: 1; min-width: 0; }
.analysis-tag {
  display: inline-flex; align-items: center; gap: 6px;
  background: rgba(255,255,255,.12);
  border: 1px solid rgba(255,255,255,.22);
  color: rgba(255,255,255,.9);
  font-size: 10.5px; font-family: var(--mono); font-weight: 600;
  letter-spacing: .1em; border-radius: 99px; padding: 3px 12px;
  margin-bottom: 12px;
}
.analysis-tag .tag-dot { width: 5px; height: 5px; border-radius: 50%; background: #4ade80; }
.hero-title { font-size: 24px; font-weight: 800; color: #fff; line-height: 1.2; margin-bottom: 6px; }
.hero-sub   { font-size: 12.5px; color: rgba(255,255,255,.55); margin-bottom: 18px; font-family: var(--mono); letter-spacing: .05em; }

.agent-panel {
  background: rgba(0,0,0,.18);
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 10px;
  padding: 13px 16px;
}
.agent-panel-title { font-size: 10px; font-family: var(--mono); letter-spacing: .12em; color: rgba(255,255,255,.4); text-transform: uppercase; margin-bottom: 11px; }
.agent-row { margin-bottom: 9px; }
.agent-row:last-child { margin-bottom: 0; }
.agent-meta { display: flex; justify-content: space-between; font-size: 11.5px; color: rgba(255,255,255,.7); margin-bottom: 4px; }
.agent-pct { font-family: var(--mono); font-weight: 600; color: #fff; }
.prog-track { height: 4px; background: rgba(255,255,255,.12); border-radius: 2px; overflow: hidden; }
.prog-fill  { height: 100%; border-radius: 2px; background: rgba(255,255,255,.55); transition: width 1s ease; }

/* result grid */
.result-grid { padding: 22px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

.r-card {
  background: var(--card-bg);
  border-radius: 13px;
  padding: 18px 18px;
  box-shadow: 0 1px 8px rgba(0,0,0,.06);
}
.r-card-title {
  font-size: 11px; font-family: var(--mono); font-weight: 600;
  letter-spacing: .1em; color: var(--text-3); text-transform: uppercase;
  margin-bottom: 14px; padding-bottom: 10px;
  border-bottom: 1px solid #f1f5f9;
}

.xai-item {
  display: flex; gap: 11px; padding: 9px 0;
  border-bottom: 1px solid #f8fafc; font-size: 12.5px; color: #334155; line-height: 1.55;
}
.xai-item:last-child { border-bottom: none; padding-bottom: 0; }
.xai-n {
  flex-shrink: 0; width: 20px; height: 20px;
  border-radius: 5px; background: #eff6ff;
  font-size: 10px; font-weight: 700; color: var(--blue);
  font-family: var(--mono); display: flex; align-items: center; justify-content: center;
}

.advice-item { display: flex; gap: 10px; padding: 8px 0; border-bottom: 1px solid #f8fafc; font-size: 12.5px; color: #334155; line-height: 1.55; align-items: flex-start; }
.advice-item:last-child { border-bottom: none; padding-bottom: 0; }
.adv-icon { flex-shrink: 0; width: 18px; height: 18px; margin-top: 1px; }

.hotline-box { background: #fff7ed; border-radius: 9px; padding: 11px 13px; margin-top: 11px; }
.hotline-label { font-size: 10.5px; font-weight: 700; color: #92400e; font-family: var(--mono); letter-spacing: .08em; text-transform: uppercase; margin-bottom: 7px; }
.hotline-row { font-size: 12.5px; color: #1e293b; padding: 3px 0; display: flex; align-items: center; gap: 7px; }

.pro-card {
  grid-column: 1/-1;
  background: var(--navy-card);
  border-radius: 13px; padding: 18px;
  border: 1px solid var(--border);
}
.pro-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
.pro-label { font-size: 11px; font-family: var(--mono); font-weight: 600; letter-spacing: .1em; color: var(--text-2); text-transform: uppercase; }
.pro-badge { background: var(--amber-dim); color: var(--amber); border: 1px solid rgba(217,119,6,.25); font-size: 10px; font-family: var(--mono); font-weight: 700; padding: 2px 9px; border-radius: 99px; letter-spacing: .06em; }
.pro-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.pro-btn {
  border-radius: 9px; padding: 13px 14px;
  cursor: pointer; font-family: var(--font); font-size: 12.5px; font-weight: 600;
  display: flex; align-items: center; gap: 8px;
  transition: all .2s; border: 1px solid;
}
.pro-btn svg { width: 15px; height: 15px; flex-shrink: 0; }
.pro-btn-red  { background: rgba(220,38,38,.1); border-color: rgba(220,38,38,.3); color: #fca5a5; }
.pro-btn-red:hover  { background: rgba(220,38,38,.18); }
.pro-btn-teal { background: rgba(5,150,105,.1); border-color: rgba(5,150,105,.3); color: #6ee7b7; }
.pro-btn-teal:hover { background: rgba(5,150,105,.18); }
.pro-btn-sub { font-size: 11px; color: var(--text-3); margin-top: 5px; padding-left: 2px; }

.privacy-row {
  grid-column: 1/-1;
  background: #eff6ff; border: 1px solid #bfdbfe;
  border-radius: 10px; padding: 11px 15px;
  font-size: 12px; color: #1e40af; line-height: 1.6;
  display: flex; gap: 9px;
}
.privacy-row svg { flex-shrink: 0; width: 15px; height: 15px; margin-top: 2px; }

.module-row { grid-column: 1/-1; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.mod-card {
  background: var(--navy);
  border: 1px solid var(--border); border-radius: 12px;
  padding: 14px 16px; cursor: pointer; transition: border-color .2s, transform .2s;
  display: flex; align-items: center; justify-content: space-between;
}
.mod-card:hover { border-color: rgba(255,255,255,.18); transform: translateY(-1px); }
.mod-left { display: flex; align-items: center; gap: 12px; }
.mod-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.mod-dot-r { background: #f87171; box-shadow: 0 0 7px #f87171; }
.mod-dot-a { background: #fbbf24; box-shadow: 0 0 7px #fbbf24; }
.mod-title { font-size: 13px; font-weight: 600; color: var(--text-1); }
.mod-sub   { font-size: 11px; color: var(--text-3); margin-top: 2px; }
.mod-right { display: flex; align-items: center; gap: 8px; }
.mod-tag { font-size: 10px; font-family: var(--mono); font-weight: 700; padding: 2px 8px; border-radius: 4px; }
.mod-tag-r { background: var(--red-dim); color: #f87171; border: 1px solid rgba(220,38,38,.2); }
.mod-tag-a { background: var(--amber-dim); color: var(--amber); border: 1px solid rgba(217,119,6,.2); }
.mod-arrow { color: var(--text-3); font-size: 16px; }

/* ════════════════════════════════════════
   PAGE 3 — CYBER TRACING
════════════════════════════════════════ */
.p-cyber { background: var(--navy); min-height: calc(100vh - 90px); }
.cyber-sub-bar {
  background: #0a1520; padding: 10px 24px;
  display: flex; align-items: center; justify-content: space-between;
  border-bottom: 1px solid var(--border);
}
.csb-left { display: flex; align-items: center; gap: 16px; }
.csb-brand { display: flex; align-items: center; gap: 10px; }
.csb-spin {
  width: 28px; height: 28px; border-radius: 50%;
  border: 1.5px solid var(--teal); display: flex; align-items: center; justify-content: center;
  animation: spin 4s linear infinite;
}
.csb-spin svg { width: 14px; height: 14px; color: var(--teal); }
@keyframes spin { to { transform: rotate(360deg); } }
.csb-name { font-size: 12px; font-weight: 700; color: var(--text-1); font-family: var(--mono); }
.csb-sub  { font-size: 10px; color: var(--text-3); }
.recon-pill {
  background: var(--green-dim); border: 1px solid rgba(5,150,105,.3);
  color: #34d399; font-size: 10.5px; font-family: var(--mono); font-weight: 700;
  letter-spacing: .08em; padding: 4px 12px; border-radius: 99px;
  animation: breathe 2.5s ease-in-out infinite;
}
@keyframes breathe {
  0%,100% { box-shadow: 0 0 4px rgba(5,150,105,.2); }
  50%      { box-shadow: 0 0 10px rgba(5,150,105,.5); }
}
.csb-right { display: flex; align-items: center; gap: 12px; }
.threat-pill {
  background: rgba(220,38,38,.1); border: 1px solid rgba(220,38,38,.3);
  color: #fca5a5; font-family: var(--mono); font-size: 11.5px; font-weight: 700;
  padding: 5px 12px; border-radius: 7px;
}
.engines-pill {
  background: var(--navy-light); border: 1px solid var(--border);
  color: var(--text-2); font-family: var(--mono); font-size: 11px;
  padding: 5px 12px; border-radius: 7px;
}
.engines-pill b { color: var(--amber); }

.cyber-layout { display: grid; grid-template-columns: 420px 1fr; min-height: calc(100vh - 170px); }
.cyber-panel { padding: 18px 20px; overflow-y: auto; }
.cyber-panel-r { padding: 18px 20px; border-left: 1px solid var(--border); display: flex; flex-direction: column; gap: 14px; }

.dark-card {
  background: var(--navy-card); border: 1px solid var(--border);
  border-radius: 12px; padding: 14px 16px; margin-bottom: 14px;
}
.dark-card:last-child { margin-bottom: 0; }
.dc-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
.dc-label { font-size: 10.5px; font-family: var(--mono); letter-spacing: .1em; color: var(--text-3); text-transform: uppercase; }
.risk-tag { background: var(--red-dim); border: 1px solid rgba(220,38,38,.25); color: #f87171; font-size: 10px; font-family: var(--mono); font-weight: 700; padding: 2px 9px; border-radius: 5px; }

.url-bar {
  display: flex; align-items: center; gap: 8px;
  background: var(--navy); border-radius: 8px; padding: 9px 12px; margin-bottom: 10px;
}
.url-bar svg  { width: 13px; height: 13px; color: var(--text-3); flex-shrink: 0; }
.url-text { font-family: var(--mono); font-size: 12px; color: #f87171; flex: 1; word-break: break-all; }
.copy-btn { background: none; border: none; color: var(--text-3); cursor: pointer; padding: 2px 5px; border-radius: 4px; transition: color .2s; font-size: 12px; }
.copy-btn:hover { color: var(--text-1); }

.vt-bar-wrap { margin-top: 6px; }
.vt-labels { display: flex; justify-content: space-between; font-size: 10.5px; color: var(--text-3); font-family: var(--mono); margin-bottom: 5px; }
.vt-labels span:last-child { color: #f87171; font-weight: 700; }
.vt-track { height: 5px; border-radius: 3px; background: linear-gradient(90deg, #22c55e 0%, #f59e0b 55%, #ef4444 100%); position: relative; }
.vt-cursor { position: absolute; right: 5%; top: -4px; width: 13px; height: 13px; border-radius: 50%; background: #fff; border: 2px solid #ef4444; box-shadow: 0 0 8px rgba(239,68,68,.5); }
.vt-sub-labels { display: flex; justify-content: space-between; font-size: 10px; color: var(--text-3); font-family: var(--mono); margin-top: 4px; }

.meta-rows {}
.mr { display: flex; align-items: baseline; padding: 7.5px 0; border-bottom: 1px solid rgba(255,255,255,.04); font-size: 12px; }
.mr:last-child { border-bottom: none; }
.mr-key { color: var(--text-3); width: 148px; flex-shrink: 0; }
.mr-val { color: var(--text-1); font-family: var(--mono); font-size: 11.5px; flex: 1; }
.mr-val.orange { color: #fbbf24; }
.mr-val.red    { color: #f87171; }
.mr-val.dim    { color: #fbbf24; }
.badge-inline { display: inline-block; margin-left: 6px; padding: 1px 7px; border-radius: 4px; font-size: 9.5px; font-weight: 700; }
.bi-red  { background: var(--red-dim); color: #f87171; border: 1px solid rgba(220,38,38,.2); }
.bi-warn { background: var(--amber-dim); color: var(--amber); border: 1px solid rgba(217,119,6,.2); }

.geo-accent {
  background: rgba(217,119,6,.08); border: 1px solid rgba(217,119,6,.2);
  border-radius: 9px; padding: 11px 13px; margin-top: 9px;
  display: flex; justify-content: space-between; align-items: center;
}
.geo-name { font-size: 14px; font-weight: 700; color: var(--amber); }
.geo-coords { font-family: var(--mono); font-size: 10.5px; color: var(--text-3); margin-top: 3px; }
.geo-age { background: var(--red-dim); border: 1px solid rgba(220,38,38,.25); border-radius: 8px; padding: 6px 12px; text-align: center; }
.geo-age-num { font-family: var(--mono); font-size: 20px; font-weight: 800; color: #f87171; display: block; }
.geo-age-sub { font-size: 9.5px; color: #f87171; font-family: var(--mono); margin-top: 1px; }

.ports-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; margin-top: 10px; }
.port-tile { border-radius: 8px; padding: 8px 10px; }
.port-safe   { background: var(--green-dim); border: 1px solid rgba(5,150,105,.25); }
.port-warn   { background: var(--amber-dim); border: 1px solid rgba(217,119,6,.25); }
.port-danger { background: var(--red-dim);   border: 1px solid rgba(220,38,38,.25); }
.port-num  { font-family: var(--mono); font-size: 14px; font-weight: 700; }
.port-safe .port-num   { color: #34d399; }
.port-warn .port-num   { color: #fbbf24; }
.port-danger .port-num { color: #f87171; }
.port-name { font-size: 10.5px; margin-top: 2px; }
.port-safe .port-name   { color: rgba(52,211,153,.65); }
.port-warn .port-name   { color: rgba(251,191,36,.65); }
.port-danger .port-name { color: rgba(248,113,113,.65); }

/* map */
.map-card { background: var(--navy-card); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; flex: 0 0 auto; }
.map-head { padding: 10px 14px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); }
.map-title-txt { font-size: 11px; font-family: var(--mono); font-weight: 700; color: var(--text-1); letter-spacing: .08em; text-transform: uppercase; }
.live-tag { display: flex; align-items: center; gap: 5px; font-size: 10px; font-family: var(--mono); color: #34d399; }
.live-tag .led-green { width: 5px; height: 5px; }
.map-canvas { height: 180px; background: #07140e; position: relative; overflow: hidden; }
.map-grid-lines {
  position: absolute; inset: 0;
  background-image: linear-gradient(rgba(16,185,129,.06) 1px, transparent 1px), linear-gradient(90deg, rgba(16,185,129,.06) 1px, transparent 1px);
  background-size: 28px 28px;
}
.mdot { position: absolute; width: 7px; height: 7px; border-radius: 50%; transform: translate(-50%,-50%); }
.mdot-g { background: #34d399; box-shadow: 0 0 10px #34d399; }
.mdot-r { background: #f87171; box-shadow: 0 0 10px #f87171; }
.mdot-o { background: #fbbf24; box-shadow: 0 0 8px #fbbf24; }
.mdot-b { background: #60a5fa; box-shadow: 0 0 8px #60a5fa; }
.mlabel { position: absolute; font-family: var(--mono); font-size: 9px; color: rgba(255,255,255,.5); white-space: nowrap; transform: translateX(-50%); }
.mline { position: absolute; height: 1px; background: rgba(248,113,113,.3); transform-origin: left center; }

/* routing */
.routing-card { background: var(--navy-card); border: 1px solid var(--border); border-radius: 12px; padding: 13px 15px; }
.routing-head { display: flex; justify-content: space-between; font-size: 10.5px; font-family: var(--mono); color: var(--text-3); margin-bottom: 13px; letter-spacing: .08em; text-transform: uppercase; }
.routing-hops { display: flex; align-items: flex-end; padding-bottom: 2px; }
.hop { text-align: center; flex: 1; }
.hop-circle { width: 11px; height: 11px; border-radius: 50%; margin: 0 auto 6px; }
.hc-g { background: #34d399; box-shadow: 0 0 6px #34d399; }
.hc-y { background: #fbbf24; box-shadow: 0 0 6px #fbbf24; }
.hc-r { background: #f87171; box-shadow: 0 0 6px #f87171; }
.hop-city { font-family: var(--mono); font-size: 10px; font-weight: 600; color: var(--text-1); }
.hop-role { font-size: 9.5px; color: var(--text-3); margin-top: 2px; }
.hop-arr { flex: 0 0 20px; text-align: center; color: var(--text-3); font-size: 13px; padding-bottom: 16px; }

/* conclusion */
.conc-card { background: var(--navy-card); border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; }
.conc-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
.conc-title { font-size: 13px; font-weight: 700; color: var(--text-1); }
.conc-sub   { font-size: 11px; color: var(--text-3); margin-top: 2px; }
.conf-badge { background: var(--green-dim); border: 1px solid rgba(5,150,105,.25); color: #34d399; font-size: 10px; font-family: var(--mono); font-weight: 700; padding: 2px 9px; border-radius: 5px; }
.conc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; margin-bottom: 11px; }
.conc-item { background: var(--navy); border: 1px solid var(--border); border-radius: 8px; padding: 9px 11px; font-size: 11.5px; color: var(--text-2); line-height: 1.45; display: flex; gap: 7px; align-items: flex-start; }
.ci-bullet { width: 5px; height: 5px; border-radius: 50%; flex-shrink: 0; margin-top: 5px; }
.ci-g { background: #34d399; }
.ci-y { background: #fbbf24; }
.conc-text { background: rgba(0,0,0,.25); border: 1px solid var(--border); border-radius: 8px; padding: 11px 13px; font-size: 12px; color: var(--text-2); line-height: 1.65; font-family: var(--mono); margin-bottom: 11px; }
.conc-text strong { color: var(--text-1); }
.export-btn {
  width: 100%; background: var(--blue); border: none; color: #fff;
  border-radius: 9px; padding: 11px; font-family: var(--font);
  font-size: 13px; font-weight: 700; cursor: pointer;
  display: flex; align-items: center; justify-content: center; gap: 7px;
  transition: background .2s; box-shadow: 0 2px 10px rgba(37,99,235,.35);
}
.export-btn:hover { background: #1d4ed8; }
.export-btn svg { width: 14px; height: 14px; }

/* ════════════════════════════════════════
   PAGE 4 — THREAT INTEL
════════════════════════════════════════ */
.p-intel { background: var(--navy); min-height: calc(100vh - 90px); }
.intel-sub-bar {
  background: #0a1520; padding: 10px 24px;
  display: flex; align-items: center; justify-content: space-between;
  border-bottom: 1px solid var(--border);
}
.isb-left { display: flex; align-items: center; gap: 14px; }
.isb-brand { display: flex; align-items: center; gap: 10px; }
.isb-icon { width: 30px; height: 30px; border-radius: 7px; background: linear-gradient(135deg, #d97706, #dc2626); display: flex; align-items: center; justify-content: center; }
.isb-icon svg { width: 16px; height: 16px; color: white; }
.isb-name { font-size: 12px; font-weight: 700; color: var(--text-1); font-family: var(--mono); }
.isb-sub  { font-size: 10px; color: var(--text-3); }
.db-pill { background: var(--green-dim); border: 1px solid rgba(5,150,105,.25); color: #34d399; font-size: 10.5px; font-family: var(--mono); font-weight: 700; padding: 3px 12px; border-radius: 99px; }
.isb-right { display: flex; align-items: center; gap: 10px; }
.stat-chip { background: var(--navy-light); border: 1px solid var(--border); color: var(--text-2); font-family: var(--mono); font-size: 11px; padding: 4px 12px; border-radius: 7px; }
.stat-chip b { color: var(--amber); }
.stat-chip .plus { color: #34d399; }

.intel-layout { display: grid; grid-template-columns: 380px 1fr; min-height: calc(100vh - 170px); }
.intel-panel   { padding: 18px 20px; border-right: 1px solid var(--border); }
.intel-panel-r { padding: 18px 20px; display: flex; flex-direction: column; gap: 14px; }

.search-intro { background: var(--navy-card); border: 1px solid var(--border); border-radius: 12px; padding: 16px; margin-bottom: 16px; }
.search-intro h3 { font-size: 14px; font-weight: 700; color: var(--text-1); margin-bottom: 5px; }
.search-intro p  { font-size: 12px; color: var(--text-3); line-height: 1.55; }

.section-label { font-size: 10.5px; font-family: var(--mono); font-weight: 700; letter-spacing: .12em; color: var(--text-3); text-transform: uppercase; margin-bottom: 12px; margin-top: 16px; display: flex; align-items: center; gap: 8px; }

.field-wrap { margin-bottom: 11px; }
.field-name { font-size: 12px; color: var(--text-2); margin-bottom: 6px; display: flex; align-items: center; gap: 6px; }
.field-name svg { width: 13px; height: 13px; color: var(--text-3); }
.field-box {
  width: 100%; background: var(--navy);
  border: 1.5px solid var(--border); border-radius: 8px;
  padding: 9px 13px; display: flex; align-items: center; gap: 8px;
  transition: border-color .2s;
}
.field-box:focus-within { border-color: rgba(96,165,250,.4); }
.field-box svg { width: 13px; height: 13px; color: var(--text-3); flex-shrink: 0; }
.field-box input { background: none; border: none; outline: none; flex: 1; color: var(--text-1); font-family: var(--mono); font-size: 12px; }
.field-box input::placeholder { color: var(--text-3); }

.scan-btn {
  width: 100%; background: var(--navy-light); border: 1px solid var(--border);
  color: var(--text-2); border-radius: 9px; padding: 11px;
  font-family: var(--font); font-size: 13px; font-weight: 600;
  cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 7px;
  transition: all .2s; margin-top: 6px;
}
.scan-btn svg { width: 14px; height: 14px; }
.scan-btn:hover { border-color: rgba(96,165,250,.4); color: var(--text-1); }

.measure-card { background: var(--navy-card); border: 1px solid var(--border); border-radius: 12px; padding: 16px; }
.mc-head { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
.mc-dot { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.mc-dot-red  { background: var(--red-dim); }
.mc-dot-teal { background: var(--green-dim); }
.mc-dot svg { width: 16px; height: 16px; }
.mc-title { font-size: 13px; font-weight: 700; color: var(--text-1); }
.mc-sub   { font-size: 11px; color: var(--text-3); margin-top: 2px; }

.trap-box { background: var(--navy); border: 1px solid var(--border); border-radius: 10px; padding: 13px 14px; margin-bottom: 12px; }
.trap-head { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
.trap-title { font-size: 12.5px; font-weight: 700; color: var(--text-1); }
.honey-badge { background: var(--amber-dim); border: 1px solid rgba(217,119,6,.25); color: var(--amber); font-size: 9.5px; font-family: var(--mono); font-weight: 700; padding: 2px 7px; border-radius: 4px; }
.trap-desc { font-size: 12px; color: var(--text-3); line-height: 1.55; margin-bottom: 11px; }
.bait-label { font-size: 10.5px; font-family: var(--mono); letter-spacing: .08em; color: var(--text-3); text-transform: uppercase; margin-bottom: 7px; }
.bait-row {
  background: var(--navy-card); border: 1px solid var(--border);
  border-radius: 8px; padding: 9px 12px;
  display: flex; align-items: center; justify-content: space-between;
}
.bait-row-left { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--text-1); }
.bait-row-left svg { width: 14px; height: 14px; color: var(--text-3); }
.most-eff { background: var(--red-dim); border: 1px solid rgba(220,38,38,.2); color: #f87171; font-size: 9.5px; font-family: var(--mono); font-weight: 700; padding: 2px 8px; border-radius: 4px; }
.gen-trap-btn {
  width: 100%; margin-top: 11px;
  background: rgba(220,38,38,.1); border: 1px solid rgba(220,38,38,.3);
  color: #fca5a5; border-radius: 8px; padding: 11px;
  font-family: var(--font); font-size: 13px; font-weight: 700;
  cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 7px;
  transition: all .2s;
}
.gen-trap-btn svg { width: 15px; height: 15px; }
.gen-trap-btn:hover { background: rgba(220,38,38,.18); }

.report-card { background: var(--navy-card); border: 1px solid var(--border); border-radius: 12px; padding: 16px; }
.report-card p { font-size: 12px; color: var(--text-3); line-height: 1.55; margin-bottom: 13px; }

.pr-items {}
.pr-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 7.5px 0; border-bottom: 1px solid rgba(255,255,255,.04); font-size: 12px;
}
.pr-row:last-child { border-bottom: none; }
.pr-row-left { display: flex; align-items: center; gap: 8px; }
.pr-check { width: 14px; height: 14px; border-radius: 3px; flex-shrink: 0; }
.pr-check-on  { background: var(--green-dim); border: 1.5px solid rgba(5,150,105,.4); }
.pr-check-off { background: rgba(255,255,255,.03); border: 1.5px solid rgba(255,255,255,.08); }
.pr-check-on::after { content: ''; display: block; width: 5px; height: 3px; border-left: 1.5px solid #34d399; border-bottom: 1.5px solid #34d399; transform: rotate(-45deg) translate(2px, 0); margin-top: 3px; margin-left: 3px; }
.pr-text { color: var(--text-2); }
.pr-text.dim { color: var(--text-3); }
.pr-status { font-family: var(--mono); font-size: 9.5px; font-weight: 700; padding: 2px 8px; border-radius: 4px; }
.ps-hash   { background: var(--green-dim); color: #34d399; border: 1px solid rgba(5,150,105,.2); }
.ps-mask   { background: var(--amber-dim); color: var(--amber); border: 1px solid rgba(217,119,6,.2); }
.ps-enc    { background: rgba(99,102,241,.12); color: #a5b4fc; border: 1px solid rgba(99,102,241,.2); }
.ps-excl   { background: rgba(255,255,255,.04); color: var(--text-3); border: 1px solid var(--border); }

.toggle-row { display: flex; justify-content: space-between; align-items: center; padding: 11px 0; border-top: 1px solid rgba(255,255,255,.04); margin-top: 8px; }
.toggle-info .ti-title { font-size: 12px; color: var(--text-1); font-weight: 500; }
.toggle-info .ti-sub   { font-size: 10.5px; color: var(--text-3); margin-top: 2px; }
.toggle { position: relative; width: 36px; height: 20px; cursor: pointer; flex-shrink: 0; }
.toggle input { opacity: 0; width: 0; height: 0; position: absolute; }
.tslider { position: absolute; inset: 0; border-radius: 20px; background: rgba(37,99,235,.15); border: 1px solid rgba(37,99,235,.3); transition: all .3s; }
.tslider::before { content: ''; position: absolute; width: 14px; height: 14px; border-radius: 50%; background: #60a5fa; top: 2px; left: 2px; transition: all .3s; box-shadow: 0 0 5px rgba(96,165,250,.5); }
.toggle input:checked + .tslider::before { transform: translateX(16px); }

.zkp-bar { background: var(--green-dim); border: 1px solid rgba(5,150,105,.2); border-radius: 8px; padding: 9px 12px; font-size: 11.5px; color: #34d399; line-height: 1.55; margin-bottom: 12px; display: flex; gap: 8px; }
.zkp-bar svg { width: 14px; height: 14px; flex-shrink: 0; margin-top: 1px; }
.submit-btn {
  width: 100%; background: rgba(5,150,105,.12); border: 1px solid rgba(5,150,105,.3);
  color: #34d399; border-radius: 9px; padding: 13px;
  font-family: var(--font); font-size: 13.5px; font-weight: 700;
  cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;
  transition: all .2s; box-shadow: 0 2px 12px rgba(5,150,105,.1);
}
.submit-btn svg { width: 15px; height: 15px; }
.submit-btn:hover { background: rgba(5,150,105,.2); }

.crowd-bar { background: var(--navy-card); border: 1px solid var(--border); border-radius: 10px; padding: 13px 15px; font-size: 11.5px; color: var(--text-3); line-height: 1.6; display: flex; gap: 9px; }
.crowd-bar svg { width: 14px; height: 14px; flex-shrink: 0; margin-top: 2px; color: var(--text-3); }

/* ── LOADING ─────────────────────────────── */
.loading-overlay {
  display: none; position: fixed; inset: 0;
  background: rgba(10,20,34,.92); z-index: 200;
  flex-direction: column; align-items: center; justify-content: center; gap: 18px;
}
.loading-overlay.show { display: flex; }
.loader-ring { width: 52px; height: 52px; border-radius: 50%; border: 3px solid var(--navy-light); border-top-color: var(--blue); animation: spin .8s linear infinite; }
.load-text { font-family: var(--mono); color: var(--text-1); font-size: 13.5px; }
.load-sub  { font-family: var(--mono); color: var(--text-3); font-size: 11.5px; }

/* toast */
.toast { position: fixed; bottom: 20px; right: 20px; background: var(--green); color: #fff; padding: 8px 16px; border-radius: 8px; font-size: 12.5px; font-family: var(--mono); opacity: 0; transition: opacity .3s; pointer-events: none; z-index: 300; }
.toast.show { opacity: 1; }

/* cyber tabs */
.ctabs { display: flex; gap: 0; margin-bottom: 16px; }
.ctab { flex: 1; padding: 8px 12px; background: var(--navy-light); border: 1px solid var(--border); color: var(--text-3); cursor: pointer; font-family: var(--mono); font-size: 11px; font-weight: 600; transition: all .2s; display: flex; align-items: center; gap: 6px; }
.ctab svg { width: 12px; height: 12px; }
.ctab:first-child { border-radius: 8px 0 0 8px; }
.ctab:last-child  { border-radius: 0 8px 8px 0; border-left: none; }
.ctab.active { background: var(--blue); color: #fff; border-color: var(--blue); }

/* scrollbar */
::-webkit-scrollbar { width: 4px; height: 4px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--navy-light); border-radius: 2px; }

@media (max-width: 900px) {
  .type-grid { grid-template-columns: repeat(2,1fr); }
  .result-grid, .module-row, .pro-btns { grid-template-columns: 1fr; }
  .r-card:nth-child(2), .pro-card, .privacy-row, .module-row { grid-column: 1; }
  .cyber-layout, .intel-layout { grid-template-columns: 1fr; }
  .conc-grid { grid-template-columns: 1fr; }
}
</style>
</head>
